# ClaimVault Environment Configuration
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173

# MongoDB Connection
# Leave empty or set to "memory" to automatically boot an embedded local MongoDB instance (great for instant local testing).
# Set to your MongoDB Atlas URI in production: mongodb+srv://<user>:<pass>@cluster.mongodb.net/claimvault
MONGODB_URI=

# Optional Redis URL for BullMQ background workers (falls back to deterministic in-process cron scheduler when unset)
REDIS_URL=

# Authentication Secrets (auto-generated securely in dev if omitted; required in production)
JWT_ACCESS_SECRET=claimvault-dev-access-secret-change-in-production-32chars
JWT_REFRESH_SECRET=claimvault-dev-refresh-secret-change-in-production-32chars

# Optional Multimodal AI Extraction Keys (uses local Tesseract/deterministic parser fallback when omitted)
GEMINI_API_KEY=
OPENAI_API_KEY=
AI_PRIMARY_PROVIDER=auto

# Optional S3 / Cloudinary Proof Storage (uses local server/uploads/proofs disk storage when omitted)
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional Notification Webhooks
WHATSAPP_WEBHOOK_URL=
SMTP_URL=
