{
  "name": "@claimvault/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p ../shared/tsconfig.json && tsc -p tsconfig.json",
    "start": "node dist/index.js",
