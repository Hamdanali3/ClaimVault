# ==============================================================================
# ClaimVault — Environment Configuration (.env)
# Rename or copy this file to `.env` in the repository root: D:\StartUp\ClaimVault\.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & URLS (REQUIRED)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# Local Vite dev URL: http://localhost:5173
# Production Vercel/custom URL: https://your-claimvault-app.vercel.app
CLIENT_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 2. DATABASE — MONGODB ATLAS (REQUIRED FOR PRODUCTION)
# ------------------------------------------------------------------------------
# Leave blank locally to auto-run embedded MongoDB (server/.mongodb-local).
# In production, paste your MongoDB Atlas SRV URI:
# Format: mongodb+srv://<db_user>:<db_password>@<cluster-name>.mongodb.net/claimvault?retryWrites=true&w=majority
MONGODB_URI=

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION SECRETS (REQUIRED — REPLACE IN PRODUCTION)
# ------------------------------------------------------------------------------
# Generate two separate 64-char hex strings via:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-64-char-random-hex-access-secret-key
JWT_REFRESH_SECRET=replace-with-64-char-random-hex-refresh-secret-key

# ------------------------------------------------------------------------------
# 4. MULTIMODAL AI EXTRACTION APIS (RECOMMENDED AT THIS STAGE)
# ------------------------------------------------------------------------------
# Provider mode: auto | gemini | openai | local
# With `auto`, Gemini runs first -> OpenAI fallback -> local Tesseract/regex fallback.
AI_PRIMARY_PROVIDER=auto

# [Recommended Primary] Google AI Studio (Gemini 2.5 Flash Vision + Structured JSON)
# Get key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# [Optional Fallback] OpenAI (gpt-4o-mini Vision + JSON mode)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. BACKGROUND WORKERS — UPSTASH REDIS / BULLMQ (OPTIONAL)
# ------------------------------------------------------------------------------
# Leave blank to use the built-in in-process cron deadline sweeper.
# For persistent multi-instance BullMQ queues, paste your Upstash/Redis TLS URL:
# Format: rediss://default:<password>@<endpoint>.upstash.io:6379
REDIS_URL=

# ------------------------------------------------------------------------------
# 6. ALERT DELIVERY HOOKS (OPTIONAL)
# ------------------------------------------------------------------------------
# Live today: JSON POST webhook (e.g., Make / n8n / Zapier / custom WhatsApp relay)
WHATSAPP_WEBHOOK_URL=

# Placeholder in EnvSchema (requires wiring nodemailer or Resend SDK in emailDispatcher.ts)
SMTP_URL=

# ------------------------------------------------------------------------------
# 7. CLOUD PROOF STORAGE (FUTURE — CURRENTLY USES LOCAL DISK `server/uploads/proofs`)
# ------------------------------------------------------------------------------
# Keep STORAGE_DRIVER=local until an S3/R2/Cloudinary adapter is wired into server/src/config/storage.ts
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
